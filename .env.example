# Copy this file to .env, then put your own API key below.

# Your API key (required)
LLM_API_KEY=your_api_key_here

# Gateway URL (optional)
# Only if you use a gateway instead of OpenAI: remove the "#" and set your URL.
# LLM_BASE_URL=https://your-gateway.example.com

# Model name (optional)
LLM_MODEL=gpt-5-mini

# Faster answers (optional)
# Works with gpt-5 models. Delete this line if you use a different model.
LLM_REASONING_EFFORT=minimal
